# Copia este archivo como .env en cada app que lo necesite. Nunca subas valores reales.
# Base de datos (usuario de aplicación SIN privilegios de superusuario)
DATABASE_URL=postgresql://konnecttia_app:CHANGE_ME@localhost:5432/konnecttia
# Supabase Auth (solo autenticación)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Email transaccional
RESEND_API_KEY=
EMAIL_FROM="Konnecttia <notificaciones@konnecttia.com>"
# WhatsApp vía Kapso (complemento)
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
# Secreto compartido para webhooks entrantes de n8n
N8N_WEBHOOK_SECRET=
