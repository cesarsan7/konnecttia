# URL de la API vista desde el servidor de Next (red interna de EasyPanel).
API_URL=http://konnecttia-api:3001
# URL de la API vista desde el navegador del cliente (dominio público). Se lee en tiempo de
# ejecución, no al compilar: EasyPanel no pasa variables en el build.
API_PUBLIC_URL=https://api.staging.konnecttia.com
# Login del panel del restaurante (Supabase Auth). La clave anon es pública por diseño: la
# seguridad la ponen la API (token + membresía + permisos) y las reglas de Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Opcional: clave pública del sitio de Cloudflare Turnstile (captcha invisible del checkout). Sin ella
# no se carga el captcha. Se lee en tiempo de ejecución. Va junto con TURNSTILE_SECRET_KEY en la API.
# Si se añade una CSP, permitir https://challenges.cloudflare.com (script-src, frame-src, connect-src).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
