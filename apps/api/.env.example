# Usuario de base de datos de la aplicación (no `postgres`).
DATABASE_URL=postgresql://konnecttia_app:CHANGE_ME@host:5432/restaurante_mvp
SUPABASE_URL=
SUPABASE_ANON_KEY=
PORT=3001
# Cabecera con la IP real del cliente, fijada por Traefik.
CLIENT_IP_HEADER=x-real-ip
# Orígenes del navegador autorizados (CORS), separados por comas.
ALLOWED_ORIGINS=https://konnecttia.com,https://pedir.konnecttia.com,https://app.konnecttia.com
# Opcional: invitaciones al equipo por email con Resend. Sin clave, solo se comparte el enlace.
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend.
RESEND_FROM=EasyOrder <hola@konnecttia.com>
# Opcional: URL pública del panel para los enlaces de los emails (si no, se usa el Origin de la petición).
PANEL_PUBLIC_URL=
# Opcional: captcha invisible Cloudflare Turnstile en el checkout web (clave SECRETA). Sin ella no se
# exige captcha. Va junto con NEXT_PUBLIC_TURNSTILE_SITE_KEY en la web.
TURNSTILE_SECRET_KEY=

# Opcional: antifraude capa 3 (ADR 0011), código de verificación por WhatsApp desde el número central de
# Konnecttia. Sin estas variables la capa está apagada aunque un restaurante tenga antifraude_codigo_canal.
# Plantilla de categoría «autenticación» aprobada en Meta (el código solo puede ir en esa categoría).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CODE_TEMPLATE=codigo_verificacion
WHATSAPP_CODE_LANGUAGE=es
# Secreto del HMAC con el que se guarda el hash de cada código (32 caracteres o más). Obligatorio si hay
# WhatsApp o simulación. Generar con: openssl rand -hex 32
CODE_HMAC_SECRET=
# SOLO staging, mientras Meta aprueba la plantilla: el código se escribe en el log de la API en vez de
# enviarse. Nunca en producción.
ANTIFRAUD_CODE_SIMULATE=false
