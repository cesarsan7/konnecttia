{
  "name": "@konnecttia/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --banner:js=\"import{createRequire}from\\\"node:module\\\";const require=createRequire(import.meta.url);\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@konnecttia/access": "workspace:*",
    "@konnecttia/domain": "workspace:*",
    "@konnecttia/notifications": "workspace:*",
    "@supabase/supabase-js": "^2.119.0",
    "hono": "^4.13.16",
    "postgres": "^4.1.0",
    "web-push": "^4.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0"
  }
}
