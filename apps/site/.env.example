# Envío de solicitudes de demo por email (Resend). Sin estas variables el formulario
# responde que el envío no está disponible y no guarda nada.
RESEND_API_KEY=
DEMO_REQUEST_TO=hola@konnecttia.com
EMAIL_FROM="Konnecttia <web@konnecttia.com>"

# Login del panel de EasyOrder (enlace «Acceder» y «EasyOrder · Acceso restaurantes»).
EASYORDER_PANEL_URL=https://n8nlearning-konnecttia-easyorder.avtsif.easypanel.host/panel
