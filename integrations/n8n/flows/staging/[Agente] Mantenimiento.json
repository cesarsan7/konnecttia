        "jsCode": "// Mensajes que la API pide enviar: cambios de estado, avisos de caducidad y cancelaciones de pago.\nconst r = $input.first().json || {};\nconst lista = [...(r.estados || []), ...(r.avisos || []), ...(r.pedidos_cancelados || [])];\nreturn lista\n  .filter((m) => m && m.canal_id && m.destinatario && m.texto)\n  .map((m) => ({\n    json: {\n      restaurante_id: m.restaurante_id,\n      canal_id: m.canal_id,\n      destinatario: m.destinatario,\n      texto: m.texto,\n    },\n  }));\n"
