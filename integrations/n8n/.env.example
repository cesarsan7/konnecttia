# Valores de un entorno para `scripts/renderizar.py`. Copiar a `.env.staging` (no se sube a git).
# Sin barra final. Nunca poner aquí tokens ni contraseñas: esos van en las credenciales de n8n.

# URL pública del Chatwoot del entorno (sin /api/...)
CHATWOOT_URL=https://chatwoot.ejemplo.com
# Número de cuenta de Chatwoot (el de /app/accounts/<n>/ en la URL de la bandeja)
CHATWOOT_CUENTA=1
# Proyecto de Supabase con la función webhook-intervention (Derivar Humano). Ver ADR 0008.
SUPABASE_FUNCIONES_URL=https://proyecto.supabase.co

# --- scripts/publicar.py (publicar los flujos en n8n por su API) ---
# URL pública de n8n (sin /api). La clave de la API de n8n va en la variable de entorno N8N_API_KEY.
N8N_URL=https://n8n.ejemplo.com
# Id de cada credencial de n8n (último tramo de su URL: /home/credentials/<id>). Nombre con
# espacios cambiados por «_». Sin id, el nodo queda con el nombre y se elige a mano.
CRED_staging_postgres=
CRED_staging_kapso=
CRED_staging_openai=
